# Macro&Micro environment тохиргооны жишээ.
# Энэ файлыг .env болгон хуулж, shell дээрээ export хийнэ:
#   set -a; source .env; set +a; python app.py
# Бодит нууц үг/secret энд болон source code-д бичихгүй.
# SQLite нь credential шаарддаггүй — зөвхөн файлын зам хэрэгтэй.

DATABASE_PATH=db/macro2micro.db
MAX_UPLOAD_MB=5
CONFIDENCE_THRESHOLD=0.60
FLASK_DEBUG=1
PORT=5000

MACRO2MICRO_MODEL_PATH=macro2micro_model.pkl
PATHMNIST_MODEL_PATH=pathmnist_model.keras
